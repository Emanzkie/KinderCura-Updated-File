{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "SIGN-UP,LOGIN/**",
          "PARENT/**",
          "PEDIA/**",
          "ADMIN/**",
          "SECRETARY/**",
          "CSS files/**",
          "ICONS/**",
          "js/**",
          "assets/**",
          "public/**",
          "views/**",
          "uploads/**",
          "api.js",
          "notifications-card-ui.js",
          "notifications-card-ui.css",
          "questions-database.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
