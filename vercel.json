{
  "functions": {
    "api/index.js": {
      "includeFiles": "{SIGN-UP\\,LOGIN/**,PARENT/**,PEDIA/**,ADMIN/**,SECRETARY/**,CSS files/**,ICONS/**,js/**,assets/**,public/**,views/**,uploads/**,api.js,notifications-card-ui.js,notifications-card-ui.css,questions-database.json}"
    }
  },
  "routes": [
    {
      "src": "/api/py/train",
      "dest": "api/ml_train.py"
    },
    {
      "src": "/api/py/predict",
      "dest": "api/ml_predict.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
