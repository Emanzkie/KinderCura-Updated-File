{
  "name": "kindercura-backend",
  "version": "2.0.0",
  "description": "KinderCura API Server — Node.js + MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node --no-deprecation server.js",
    "dev": "nodemon --no-deprecation server.js",
    "test": "node tests/unit/models.test.js",
    "migrate:appointment-slots": "node scripts/migrate-appointment-slots.js",
    "migrate:appointment-slots:round": "node scripts/migrate-appointment-slots.js --mode=round",
    "rollback:appointment-slots": "node scripts/rollback-appointment-slots.js",
    "seed:core-bank": "node scripts/seed-core-bank-questions.js",
    "seed:core-bank:dry": "node scripts/seed-core-bank-questions.js --dry-run",
    "backfill:answer-origin": "node scripts/backfill-answer-origin.js",
    "backfill:answer-origin:dry": "node scripts/backfill-answer-origin.js --dry-run",
    "backfill:scoring-bands": "node scripts/backfill-scoring-bands.js --dry-run",
    "backfill:scoring-bands:dry": "node scripts/backfill-scoring-bands.js --dry-run",
    "backfill:scoring-bands:apply": "node scripts/backfill-scoring-bands.js --apply",
    "migrate:dataset-status": "node scripts/migrate-dataset-status-registered.js --dry-run",
    "migrate:dataset-status:dry": "node scripts/migrate-dataset-status-registered.js --dry-run",
    "migrate:dataset-status:apply": "node scripts/migrate-dataset-status-registered.js --apply"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "mongoose": "^8.23.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
