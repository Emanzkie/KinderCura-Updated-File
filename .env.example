# Example environment variables for KinderCura — PLACEHOLDERS ONLY.
# Copy this to `.env` for local development and fill in your own values.
# For production, add each one under Vercel -> Project Settings -> Environment
# Variables (Production + Preview). Never commit real values: `.env` is
# git-ignored, and this template is the only env file that is tracked.
#
# Only variables the application actually reads are listed here. Platform
# variables (VERCEL, VERCEL_URL, NOW_REGION, RENDER, FLY_APP_NAME, NODE_ENV)
# are set by the host and must not be set by hand.

# ── MongoDB (REQUIRED) ────────────────────────────────────────────
# Use a hosted MongoDB (MongoDB Atlas). DO NOT use localhost on Vercel.
# Example (SRV):
# MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER-HOST>/<DATABASE>?retryWrites=true&w=majority
#
# The app throws a clear error at connect time if this is not set.
# Atlas Network Access must allow 0.0.0.0/0 (or Vercel's egress range),
# otherwise every serverless invocation fails to connect.
MONGODB_URI=

# ── Authentication (REQUIRED) ─────────────────────────────────────
# Signs and verifies every JWT. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left blank on purpose: with no secret the server refuses to issue tokens,
# whereas a copied-in default would let anyone forge one. Changing it logs
# every user out.
JWT_SECRET=

# ── File uploads / object storage ────────────────────────────────
# Uploads are PRC ID cards, profile photos, e-wallet payment proofs, videos
# and ML datasets. Hosts with an ephemeral filesystem (Render Free, Vercel,
# Fly, …) lose anything written to local disk on the next restart / redeploy /
# spin-down, so on those hosts the app must push uploads to object storage.
#
# Turn object storage ON with USE_BLOB and configure exactly ONE backend
# below. This switch is host-independent — it does NOT look at VERCEL.
# Leave USE_BLOB unset for local development: uploads go to disk as before.
USE_BLOB=

# ── Backend A: Cloudflare R2 (recommended — works on any host) ────
# R2 exposes an S3-compatible API. Create a bucket (keep it PRIVATE) and an
# R2 API token, then set:
#   R2_ENDPOINT           https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#                         (or leave blank and set R2_ACCOUNT_ID instead)
#   R2_BUCKET             the bucket name
#   R2_ACCESS_KEY_ID      from the R2 API token
#   R2_SECRET_ACCESS_KEY  from the R2 API token
#   R2_ACCOUNT_ID         optional — only used to build R2_ENDPOINT when it is blank
#   R2_REGION             optional — SigV4 region label, defaults to "auto"
# Files are streamed back to the browser through Express (existing /uploads/...
# URLs are unchanged); the bucket is never made public.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_REGION=

# ── Backend B: Vercel Blob (legacy) ─────────────────────────────
# Only for deployments still on Vercel. Create a Blob store from the Vercel
# dashboard (Storage -> Create -> Blob); Vercel injects BLOB_READ_WRITE_TOKEN.
# A Vercel deployment that already had VERCEL + this token keeps working even
# without USE_BLOB set.
BLOB_READ_WRITE_TOKEN=
# Optional. 'public' only if the Blob store itself was created public; anything
# else (including unset) is treated as private, which is the recommended setup.
# BLOB_STORE_ACCESS=private

# ── Email / OTP (REQUIRED for registration) ───────────────────────
# Gmail account plus a Google App Password (not the account password).
# Registration is gated on OTP email verification, so without these no new
# account can be created. When unset, emails are logged instead of sent.
EMAIL_USER=
EMAIL_PASS=

# ── PayMongo (REQUIRED for "Pay Online") ──────────────────────────
# Use TEST keys (sk_test_…) until the clinic goes live. Only the SECRET key is
# read by the server; it must never be sent to the browser. Without it, "Pay
# Online" returns a clear 503 and parents can still use Pay at Clinic.
PAYMONGO_SECRET_KEY=

# Copied from the PayMongo dashboard when you create the webhook endpoint.
# Webhook deliveries are rejected with HTTP 401 unless this is set, so online
# payments will not settle automatically without it.
PAYMONGO_WEBHOOK_SECRET=

# Optional. Defaults to 'v1' — the Checkout Sessions endpoint PayMongo
# publicly documents. Set to 'v2' only if your account is enrolled in a
# newer API version and you have confirmed it works with a test key.
# PAYMONGO_API_VERSION=v1

# ── ML training / prediction service ─────────────────────────────
# ML_SERVICE_SECRET is compared against the 'x-ml-secret' header by the Python
# functions (api/ml_train.py, api/ml_predict.py) and sent by the Node server.
# Use a long random value; set the SAME value wherever both sides run.
ML_SERVICE_SECRET=
# Optional. Base URL of the deployment that hosts /api/py/train and
# /api/py/predict. Setting it (or running on Vercel) switches the ML calls to
# remote mode; leave blank for local development, which spawns Python locally.
ML_SERVICE_URL=
# Optional. Set to 'true' to force local Python even when VERCEL or
# ML_SERVICE_URL would otherwise select remote mode.
# USE_LOCAL_PYTHON=true

# ── Public URL (recommended) ──────────────────────────────────────
# Origin used for links and images inside outgoing emails, and for the
# success / cancel URLs PayMongo returns the parent to after checkout.
# On Vercel this falls back to the deployment's own hostname when unset,
# but set it explicitly to your production domain so email links stay
# stable across preview deployments.
# APP_URL=https://your-project.example.com
APP_URL=

# ── Local development only ────────────────────────────────────────
# Vercel assigns the port itself; PORT is ignored there.
PORT=3001

# Set to 'true' to let the Parent appointment page's pediatrician list include
# the synthetic demo pediatrician accounts (useful when there is only one real
# pediatrician account to test the selection UI with). NEVER set this in
# Production/Preview — those accounts share one discarded password hash and
# cannot log in to answer a real booking.
SHOW_SYNTHETIC_PEDIATRICIANS_TO_PARENTS=

# Notes:
# - Do not use localhost or 127.0.0.1 in any Vercel value; those point at the
#   ephemeral serverless runtime, not at your machine.
# - Set every variable for BOTH Production and Preview, or preview
#   deployments will fail at runtime with 503s.
