{"nodes": [{"id": "docs_audit_summary_audit_summary", "label": "KinderCura Audit Summary", "file_type": "document", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_summary_rule_based_screening", "label": "Rule-Based Screening System", "file_type": "rationale", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transparent clinician-informed rules are auditable: every result traces to a specific answer and threshold, which matters in pediatrics. The risk is describing the system as ML when it is not."}, {"id": "docs_audit_summary_ml_never_operational", "label": "ML Directory Never Operational", "file_type": "concept", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero trained-model records and no model file at audit time; prediction path always fell back to rules. Retained for transparency and labelled 'Experimental - not used for live screening results'."}, {"id": "docs_audit_summary_rule_derived_label_leakage", "label": "Rule-Derived Training Labels (Circular Learning)", "file_type": "rationale", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generating labels from the rule engine's cutoffs makes a model memorise the if/else logic; near-100% accuracy would say nothing about child development."}, {"id": "docs_audit_summary_bankers_rounding_finding", "label": "Banker's Rounding Provenance Finding", "file_type": "concept", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "overall_score matched Python round-half-to-even on 60/60 rows but JS Math.round on only 45/60, proving the demo CSV came from a Python generator, not KinderCura."}, {"id": "docs_audit_summary_synthetic_demo_fixtures", "label": "Synthetic Demo Fixture Datasets", "file_type": "concept", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_summary_ecdi2030", "label": "ECDI2030 (UNICEF)", "file_type": "concept", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_summary_dscore_childdevdata", "label": "D-score / childdevdata", "file_type": "concept", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_summary_models_trained_counter", "label": "Models Trained Counter Correction", "file_type": "concept", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counter read a dataset status flag set on upload registration; now reads the trained-model collection directly (0)."}, {"id": "docs_audit_summary_clinical_outcome_field", "label": "Structured Clinical Outcome Field (clinicalOutcome)", "file_type": "concept", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added because the only free-text diagnosis was 'Yes please'; a structured, independent clinician conclusion is the only valid training label."}, {"id": "docs_audit_summary_ml_claim_prerequisites", "label": "Prerequisites Before Any ML Claim", "file_type": "rationale", "source_file": "docs/AUDIT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collect real labels