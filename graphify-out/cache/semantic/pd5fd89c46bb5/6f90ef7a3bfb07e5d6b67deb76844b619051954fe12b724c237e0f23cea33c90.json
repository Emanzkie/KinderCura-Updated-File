e": "concept", "source_file": "docs/synthetic-data-and-model-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_synthetic_data_and_model_pipeline_defect_injection", "label": "Deliberate Defect Injection (--defect-rate)", "file_type": "rationale", "source_file": "docs/synthetic-data-and-model-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A generator emitting only perfect rows makes the cleaning stage untestable; counted injected faults let cleaning counts be reconciled."}, {"id": "docs_synthetic_data_and_model_pipeline_cleaning_report", "label": "Cleaning Report Reconciliation (50,179 - 217 - 651 = 49,311)", "file_type": "concept", "source_file": "docs/synthetic-data-and-model-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_synthetic_data_and_model_pipeline_normalization_off", "label": "Normalization Off by Default", "file_type": "rationale", "source_file": "docs/synthetic-data-and-model-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RandomForest is scale-invariant; min-max scaling would change nothing while breaking the 'columns are percentages' contract."}, {"id": "docs_synthetic_data_and_model_pipeline_not_administered_sentinel", "label": "-1 Not-Administered Sentinel Applied at Train Time", "file_type": "concept", "source_file": "docs/synthetic-data-and-model-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_synthetic_data_and_model_pipeline_model_v4_metrics", "label": "Model v4 Metrics (~63% Accuracy)", "file_type": "concept", "source_file": "docs/synthetic-data-and-model-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "autho